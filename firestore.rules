rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidVaultRecord(data, userId) {
      return data.userId == userId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.category in ['login_credential', 'secret_note', 'api_key', 'identity_doc', 'financial', 'recovery_phrase']
        && data.encryptedData is map
        && data.createdAt is string
        && data.updatedAt is string;
    }

    // User isolated private vault collection
    match /users/{userId}/vault/{recordId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId)
        && isValidId(recordId)
        && isValidVaultRecord(incoming(), userId);
      allow update: if isOwner(userId)
        && isValidId(recordId)
        && incoming().userId == existing().userId
        && isValidVaultRecord(incoming(), userId);
      allow delete: if isOwner(userId);
    }
  }
}
